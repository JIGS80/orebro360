"assets/slottet/olm-odat82-1-s.jpg","w":500,"h":375}],"kallor":["Riksantikvarieämbetet: Plan-Ritningar af Örebro Slott (1785)","Länsstyrelsen: Residenset på Örebro slott (2005)","Wikipedia: Örebro slott"]},{"id":"thoren","ar":"1860–1902","rubrik":"Putsen faller","text":["Under 1800-talet var slottet residens och länsstyrelse. Sommaren 1810 bodde kungaparet här under riksdagen som valde Jean Baptiste Bernadotte till tronföljare. Fotografierna från 1860-talet visar fortfarande Hårlemans slott: slätputsat, med låga tornhuvar.","1897–1901 restaurerades slottet av arkitekten Thor Thorén i nationalromantisk anda. Putsen knackades bort så att stenen syntes, taket fick skiffer från Grythyttan, tornen fick nya överdelar och en trappgavel markerar det gamla kärntornet. Det är det slottet vi ser i dag."],"bilder":[{"id":"OLM-2018-33-1","titel":"Slottet omkring 1860, putsat och med låga tornhuvar.","ar":"omkring 1860","upphov":"Jaeger, Johannes","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-2018-33-1","fil":"assets/slottet/olm-2018-33-1.jpg","liten":"assets/slottet/olm-2018-33-1-s.jpg","w":1200,"h":738},{"id":"OLM-2008-4-101","titel":"Kanslibron och slottet från Svartån.","ar":"omkring 1860","upphov":"Wikström, Alfred","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-2008-4-101","fil":"assets/slottet/olm-2008-4-101.jpg","liten":"assets/slottet/olm-2008-4-101-s.jpg","w":1099,"h":800},{"id":"e6f0ce0d-85d8-4516-b477-28300df9ab55","titel":"Slottet en vinterdag, strax innan restaureringen.","ar":"1897","upphov":"Okänd, Okänd","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/raa/dokumentation/e6f0ce0d-85d8-4516-b477-28300df9ab55","fil":"assets/slottet/e6f0ce0d-85d8-4516-b477-28300df9ab55.jpg","liten":"assets/slottet/e6f0ce0d-85d8-4516-b477-28300df9ab55-s.jpg","w":1400,"h":814},{"id":"CL137","titel":"Slottet med de nya tornhuvarna.","ar":"1900–1901","upphov":"Liljefors, Carl","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/upmu/photo/CL137","fil":"assets/slottet/cl137.jpg","liten":"assets/slottet/cl137-s.jpg","w":1200,"h":905},{"id":"OLM-2012-25-1","titel":"Det restaurerade slottet med Kanslibron i förgrunden.","ar":"1902","upphov":"Chrysander, Johan","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-2012-25-1","fil":"assets/slottet/olm-2012-25-1.jpg","liten":"assets/slottet/olm-2012-25-1-s.jpg","w":1200,"h":832},{"id":"OLM-2012-25-5","titel":"Slottet med Stora Hotellet och Nikolaikyrkan i bakgrunden.","ar":"1902","upphov":"Chrysander, Johan","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-2012-25-5","fil":"assets/slottet/olm-2012-25-5.jpg","liten":"assets/slottet/olm-2012-25-5-s.jpg","w":1200,"h":889}],"kallor":["Länsstyrelsen Örebro län: Örebro slott","Wikipedia: Örebro slott","Länsstyrelsen: Residenset på Örebro slott (2005)"]},{"id":"restaurering","ar":"1924–1935","rubrik":"Gräva och återskapa","text":["På 1920- och 30-talen undersöktes slottet och fick delvis nya interiörer. Kärntornet grävdes ut 1924 och Håltornet 1925. Ritningar, fotografier och fynd som glasbägare och pilspetsar finns kvar hos Örebro läns museum.","1926–1930 återskapades Rikssalen, och 1929–1933 togs landshövding Hamiltons väggmålningar från 1766 fram i Stora matsalen. 1934 grävdes borggården och vallgraven ut. Året därpå, 1935, blev slottet statligt byggnadsminne."],"bilder":[{"id":"OLM-954002315-1","titel":"Plan över utgrävningen i Håltornet.","ar":"1925","upphov":"Waldén, Bertil","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-954002315-1","fil":"assets/slottet/olm-954002315-1.jpg","liten":"assets/slottet/olm-954002315-1-s.jpg","w":1200,"h":893},{"id":"OLM-954002313-1","titel":"Rekonstruktionsritning från utgrävningen i Håltornet.","ar":"1925","upphov":"Waldén, Bertil","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-954002313-1","fil":"assets/slottet/olm-954002313-1.jpg","liten":"assets/slottet/olm-954002313-1-s.jpg","w":500,"h":375},{"id":"OLM-954002320-1","titel":"Utgrävningen pågår.","ar":"1925","upphov":"Waldén, Bertil","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-954002320-1","fil":"assets/slottet/olm-954002320-1.jpg","liten":"assets/slottet/olm-954002320-1-s.jpg","w":1200,"h":893},{"id":"OLM-95400600-1","titel":"Glasbägare som hittades i Håltornet.","ar":"1925","upphov":"Waldén, Bertil","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-95400600-1","fil":"assets/slottet/olm-95400600-1.jpg","liten":"assets/slottet/olm-95400600-1-s.jpg","w":500,"h":375},{"id":"OLM-95400598-1","titel":"Pilspetsar från utgrävningen, tecknade.","ar":"1925","upphov":"Waldén, Bertil","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-95400598-1","fil":"assets/slottet/olm-95400598-1.jpg","liten":"assets/slottet/olm-95400598-1-s.jpg","w":500,"h":375},{"id":"OLM-1928189A-1","titel":"Den gamla trappan under restaureringen.","ar":"1928","upphov":"Lindskog, Samuel","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-1928189A-1","fil":"assets/slottet/olm-1928189a-1.jpg","liten":"assets/slottet/olm-1928189a-1-s.jpg","w":500,"h":375},{"id":"OLM-1930139A-1","titel":"Takkonstruktion under ombyggnaden.","ar":"1930","upphov":"Lindskog, Samuel","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-1930139A-1","fil":"assets/slottet/olm-1930139a-1.jpg","liten":"assets/slottet/olm-1930139a-1-s.jpg","w":500,"h":375},{"id":"OLM-193397-1","titel":"Rikssalen efter restaureringen.","ar":"1933","upphov":"Lindskog, Samuel","licens":"Public Domain Mark","post":"http://kulturarvsdata.se/S-OLM/photo/OLM-193397-1","fil":"assets/slottet/olm-193397-1.jpg","liten":"assets/slottet/olm-193397-1-s.jpg","w":500,"h":375}],"kallor":["Wikipedia: Örebro slott","Länsstyrelsen: Residenset på Örebro slott (2005)","Örebro läns museum via Digitalt museum","Arkeologgruppen, rapport 2022:21"]},{"id":"idag","ar":"I dag","rubrik":"Slottet i dag","text":["Slottet ägs av Statens fastighetsverk. Landshövdingen bor i residenset, som inte är öppet för allmänheten, och länsstyrelsen har kontor här. 1992–1993 renoverades de två översta våningarna så att renässanskaraktären kom fram igen.","Den som vill se slottet inifrån kan gå på utställningen om slottets historia i nordvästra tornet, följa med på en guidad tur på sommaren eller äta i Slottskrogen i källarvalven."],"bilder":[{"id":"933d2c3f-fa7a-40e8-bb88-5b883747ce59","titel":"Slottet och Svartån.","ar":"2001","upphov":"Lundberg, Bengt","licens":"CC BY 4.0","post":"http://kulturarvsdata.se/raa/dokumentation/933d2c3f-fa7a-40e8-bb88-5b883747ce59","fil":"assets/slottet/933d2c3f-fa7a-40e8-bb88-5b883747ce59.jpg","liten":"assets/slottet/933d2c3f-fa7a-40e8-bb88-5b883747ce59-s.jpg","w":900,"h":600},{"id":"b20acb3d-9807-4a0f-a75b-e72bd5ff42ef","titel":"Slottet speglat i Svartån.","ar":"2010","upphov":"Lundberg, Bengt A","licens":"CC BY 4.0","post":"http://kulturarvsdata.se/raa/dokumentation/b20acb3d-9807-4a0f-a75b-e72bd5ff42ef","fil":"assets/slottet/b20acb3d-9807-4a0f-a75b-e72bd5ff42ef.jpg","liten":"assets/slottet/b20acb3d-9807-4a0f-a75b-e72bd5ff42ef-s.jpg","w":1400,"h":932},{"id":"62f19fb1-92d2-4ebe-a2a7-fe1202e6edf1","titel":"Kanslibron och slottet.","ar":"2003","upphov":"Lundberg, Bengt A","licens":"CC BY 4.0","post":"http://kulturarvsdata.se/raa/dokumentation/62f19fb1-92d2-4ebe-a2a7-fe1202e6edf1","fil":"assets/slottet/62f19fb1-92d2-4ebe-a2a7-fe1202e6edf1.jpg","liten":"assets/slottet/62f19fb1-92d2-4ebe-a2a7-fe1202e6edf1-s.jpg","w":1400,"h":933},{"id":"1bbe2efd-2688-41e5-912b-2f97744bd6b2","titel":"Slottet och borggården från luften.","ar":"1992","upphov":"Norrman, Jan","licens":"CC BY 4.0","post":"http://kulturarvsdata.se/raa/dokumentation/1bbe2efd-2688-41e5-912b-2f97744bd6b2","fil":"assets/slottet/1bbe2efd-2688-41e5-912b-2f97744bd6b2.jpg","liten":"assets/slottet/1b